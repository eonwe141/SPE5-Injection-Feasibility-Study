# --- OPM Flow & Simulation Outputs ---
# Ignore massive binary and log files generated during simulation
*.PRT
*.LOG
*.DBG
*.RSM
*.UNRST
*.UNSMRY
*.SMSPEC
*.EGRID
*.INIT
*.INSPEC
*.RSSPEC
*.RFT

# Ignore timestep-specific output files (e.g., .S0001, .X0001)
*.[S-X][0-9][0-9][0-9][0-9]

# --- OS & Editor System Files ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# --- Archives ---
*.zip
*.tar.gz
*.rar

# --- Directory Specific Rules ---

# input-files: Ignore everything except .DATA files and .INC include files
input-files/*
!input-files/*.DATA
!input-files/*.INC
!input-files/.gitkeep

# results: Ignore everything except CSV files
results/*
!results/*.csv
!results/.gitkeep

# figures: Keep all images
!figures/
